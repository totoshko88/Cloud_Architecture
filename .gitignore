# Python build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
build/
dist/
sdist/
wheels/
.installed.cfg

# Test / coverage / cache
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Virtual environments
.venv/
venv/
env/
ENV/

# Downloaded asset packs (draw.io icon libraries, unpacked provider assets).
# Anchored to the repo-root vendor dir only — must NOT match the source package
# src/rule_engine/assets/, which is code that ships with the engine.
/assets/
asset-packs/
*.drawio-lib
azure-icons/
gcp-icons/
oci-icons/

# Bundled workspace bootstrap payload — a build-time copy of .kiro/steering,
# .kiro/hooks, mappings, and schemas staged by build_backend.py into the package.
# The repo keeps the single source of truth at the top level; this is generated.
src/rule_engine/_bootstrap/

# Local build tooling (PlantUML jar, etc.) — downloaded on demand, not committed
.build-tools/
release-dist/
# VERSION is generated by the release build stage
VERSION
# Generated asset index manifest (built from local packs)
asset-index.json

# Local Kiro tooling state (CLI settings + lock). The tracked .kiro trees
# (steering/hooks/agents/skills/specs) are the build source of truth bundled by
# build_backend.py; .kiro/settings/ is per-machine tooling state, never shipped.
.kiro/settings/

# Editor / OS
.DS_Store
# draw.io backup files (e.g. examples/aws/.$01-...drawio.bkp)
*.bkp
.$*.drawio.bkp
