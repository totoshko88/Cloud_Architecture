<mxfile host="app.diagrams.net" agent="rule-engine golden-example" version="24.0.0">
  <diagram id="gcp-vertex-pipeline" name="gcp-vertex-pipeline">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title cell (non-node: carries the vN token) -->
        <mxCell id="title" value="gcp vertex-pipeline — acme-prod / us-central1 | 2026-09-22 | v1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="720" height="30" as="geometry" />
        </mxCell>

        <!-- Boundary container: GCP Project (dashed green boundary per diagram-standards Legend) -->
        <mxCell id="boundary-project" value="project-acme-prod" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeColor=#00A000;fillColor=none;verticalAlign=top;fontColor=#00A000;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1300" height="860" as="geometry" />
        </mxCell>

        <!-- Network Boundary container: VPC (padded away from Boundary border and from its own children) -->
        <mxCell id="boundary-vpc" value="vpc-prod" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeColor=#0062AD;fillColor=none;verticalAlign=top;fontColor=#0062AD;fontSize=12" vertex="1" parent="boundary-project">
          <mxGeometry x="300" y="90" width="960" height="740" as="geometry" />
        </mxCell>

        <!-- ===== Nodes: wide, staggered grid; each store gets its own row/column ===== -->
        <!-- edge lane: API gateway (Cloud Functions) -->
        <mxCell id="api-gateway" value="api-gateway" style="shape=mxgraph.gcp2.cloud_functions;fillColor=#4285F4;strokeColor=#ffffff;aspect=fixed;html=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;align=center" vertex="1" parent="1">
          <mxGeometry x="110" y="470" width="64" height="64" as="geometry" />
        </mxCell>

        <!-- router lane: load balancer -->
        <mxCell id="load-balancer" value="load-balancer" style="shape=mxgraph.gcp2.cloud_load_balancing;fillColor=#4285F4;strokeColor=#ffffff;aspect=fixed;html=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;align=center" vertex="1" parent="1">
          <mxGeometry x="380" y="470" width="64" height="64" as="geometry" />
        </mxCell>

        <!-- async messaging lane: Pub/Sub (top row) -->
        <mxCell id="pubsub-events" value="pubsub-events" style="shape=mxgraph.gcp2.cloud_pubsub;fillColor=#4285F4;strokeColor=#ffffff;aspect=fixed;html=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;align=center" vertex="1" parent="1">
          <mxGeometry x="620" y="200" width="64" height="64" as="geometry" />
        </mxCell>

        <!-- workers lane: ingest function (top row) -->
        <mxCell id="ingest-function" value="ingest-function" style="shape=mxgraph.gcp2.cloud_functions;fillColor=#4285F4;strokeColor=#ffffff;aspect=fixed;html=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;align=center" vertex="1" parent="1">
          <mxGeometry x="880" y="200" width="64" height="64" as="geometry" />
        </mxCell>

        <!-- platform core lane: Vertex AI (central hub, middle row) -->
        <mxCell id="vertex-ai" value="vertex-ai" style="shape=mxgraph.gcp2.cloud_machine_learning;fillColor=#4285F4;strokeColor=#ffffff;aspect=fixed;html=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;align=center" vertex="1" parent="1">
          <mxGeometry x="620" y="470" width="64" height="64" as="geometry" />
        </mxCell>

        <!-- workers lane: training on GKE (bottom row, below vertex column x=620) -->
        <mxCell id="training-gke" value="training-gke" style="shape=mxgraph.gcp2.container_engine;fillColor=#4285F4;strokeColor=#ffffff;aspect=fixed;html=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;align=center" vertex="1" parent="1">
          <mxGeometry x="620" y="740" width="64" height="64" as="geometry" />
        </mxCell>

        <!-- platform core lane: Secret Manager (bottom row, below ingest column x=880) -->
        <mxCell id="secret-manager" value="secret-manager" style="shape=mxgraph.gcp2.key_management_service;fillColor=#4285F4;strokeColor=#ffffff;aspect=fixed;html=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;align=center" vertex="1" parent="1">
          <mxGeometry x="880" y="740" width="64" height="64" as="geometry" />
        </mxCell>

        <!-- data lane: Cloud SQL (far-right column, upper) -->
        <mxCell id="cloud-sql" value="cloud-sql" style="shape=mxgraph.gcp2.cloud_sql;fillColor=#4285F4;strokeColor=#ffffff;aspect=fixed;html=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;align=center" vertex="1" parent="1">
          <mxGeometry x="1140" y="400" width="64" height="64" as="geometry" />
        </mxCell>

        <!-- data lane: Cloud Storage (far-right column, lower) -->
        <mxCell id="model-storage" value="model-storage" style="shape=mxgraph.gcp2.cloud_storage;fillColor=#4285F4;strokeColor=#ffffff;aspect=fixed;html=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;align=center" vertex="1" parent="1">
          <mxGeometry x="1140" y="560" width="64" height="64" as="geometry" />
        </mxCell>

        <!-- ===== Edges: numeric markers 1..9; each run on its own grid corridor via waypoints ===== -->
        <!-- 1: api-gateway -> load-balancer (straight middle row) -->
        <mxCell id="e1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;fontStyle=1" edge="1" parent="1" source="api-gateway" target="load-balancer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 2: load-balancer -> vertex-ai (straight middle row) -->
        <mxCell id="e2" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;fontStyle=1" edge="1" parent="1" source="load-balancer" target="vertex-ai">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 3: api-gateway out-top -> pubsub in-left (async); riser at x=210 -->
        <mxCell id="e3" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;fontStyle=1" edge="1" parent="1" source="api-gateway" target="pubsub-events">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="142" y="232" />
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- 4: pubsub -> ingest-function (straight top row) -->
        <mxCell id="e4" value="4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;fontStyle=1" edge="1" parent="1" source="pubsub-events" target="ingest-function">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 5: ingest-function out-right -> training-gke in-bottom; own column x=1000 (right of secret), low corridor y=890 -->
        <mxCell id="e5" value="5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=12;fontStyle=1" edge="1" parent="1" source="ingest-function" target="training-gke">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1240" y="232" />
              <mxPoint x="1240" y="890" />
              <mxPoint x="652" y="890" />
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- 6: training-gke out-top -> vertex-ai in-bottom (straight vertical, x=668) -->
        <mxCell id="e6" value="6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;fontSize=12;fontStyle=1" edge="1" parent="1" source="training-gke" target="vertex-ai">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 7: vertex-ai out-right (upper) -> cloud-sql in-left; corridor row y=432 -->
        <mxCell id="e7" value="7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;fontStyle=1" edge="1" parent="1" source="vertex-ai" target="cloud-sql">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1060" y="486" />
              <mxPoint x="1060" y="432" />
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- 8: vertex-ai out-right (lower) -> model-storage in-left; corridor row y=592, distinct from #7 -->
        <mxCell id="e8" value="8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;fontStyle=1" edge="1" parent="1" source="vertex-ai" target="model-storage">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1090" y="518" />
              <mxPoint x="1090" y="592" />
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- 9: ingest-function out-bottom -> secret-manager in-top (straight vertical, x=912) -->
        <mxCell id="e9" value="9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontStyle=1" edge="1" parent="1" source="ingest-function" target="secret-manager">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Numbered flow legend to the RIGHT of the diagram -->
        <mxCell id="flow-legend" value="Flow&#10;1. api-gateway forwards request to load-balancer&#10;2. load-balancer routes inference to Vertex AI&#10;3. api-gateway publishes event to Pub/Sub (async)&#10;4. Pub/Sub delivers event to ingest-function (async)&#10;5. ingest-function submits training job to GKE&#10;6. GKE registers trained model with Vertex AI&#10;7. Vertex AI reads metadata from Cloud SQL&#10;8. Vertex AI stores artifacts in Cloud Storage&#10;9. ingest-function fetches credentials from Secret Manager" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;strokeColor=#000000;fillColor=#FFFFFF" vertex="1" parent="1">
          <mxGeometry x="1380" y="120" width="300" height="200" as="geometry" />
        </mxCell>

        <!-- Legend cell (non-node: value begins with "Legend") -->
        <mxCell id="legend" value="Legend&#10;Solid line = primary flow&#10;Dashed line = asynchronous / event-driven flow&#10;Red = blocked / missing / disabled&#10;🆕 = new in version N&#10;🔄 = changed in version N&#10;Dashed green boundary = stack boundary&#10;Dashed blue boundary = Network Boundary&#10;Numbered markers (1..N) = ordered data flow steps; see Flow list" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;strokeColor=#000000;fillColor=#FFFFFF" vertex="1" parent="1">
          <mxGeometry x="1380" y="360" width="300" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
